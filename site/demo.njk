---
layout: base.njk
pagination:
  data: collections.demosLatest
  size: 1
  alias: demo
  addAllPagesToCollections: true
permalink: "/{{ demo.owner }}/{{ demo.gist_id }}/"
---

{% set slug = demo.slug or (demo.owner ~ '-' ~ demo.gist_id) %}
{% set compiled_js = '/js/generated/demos/' ~ slug ~ '/main.js' %}

{# spinner removed #}

{% if demo.title or demo.tags or demo.gist_meta %}
<section class="container">
  <div class="gist-header">
    <div class="meta">
      <h1>{% if demo.title %}{{ demo.title }}{% else %}Untitled demo{% endif %}</h1>{% if demo.tags %}<div class="tags">{% for tag in demo.tags %}<span class="tag">{{ tag }}</span>{% endfor %}</div>{% endif %}
      {% if demo.gist_meta and demo.gist_meta.description %}
      <p class="gist-description">{{ demo.gist_meta.description }}</p>
      {% endif %}
      {% if demo.gist_meta and demo.gist_meta.created_at %}
      <span class="gist-timestamp">{{ demo.gist_meta.created_at | readableDate }} by <a href="https://github.com/{{ demo.owner }}" target="_blank">{{ demo.owner }}</a></span>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

<section class="container">
  <div id="error"></div>
</section>

{% if demo.broken %}
<section class="container" id="main-arena">
  <div class="broken-demo">
    <h2>This demo is no longer available</h2>
    <p>Sorry, the original gist could not be fetched:</p>
    <blockquote>{{ demo.error }}</blockquote>
    <p>You can view or restore the gist directly on <a href="https://github.com/{{ demo.owner }}/gist/{{ demo.gist_id }}" target="_blank">GitHub</a>.</p>
  </div>
</section>
{% else %}
<section class="container" id="main-arena">
  <canvas id="canvas-area" width="800" height="600"></canvas>
  <canvas id="webgl-area" width="800" height="600"></canvas>
  <svg id="svg-area"></svg>
  <div id="console"></div>
</section>
{% endif %}

<a class="github-ribbon" href="https://github.com/{{ demo.owner }}/gist/{{ demo.gist_id }}" title="View original gist">{{ demo.owner }}/{{ demo.gist_id }}</a>

{% if not demo.broken and demo.gist_meta and demo.gist_meta.files %}
<section class="container">
  {% for file in demo.gist_meta.files %}
  {% set rendered = file | renderSource(slug) %}
  <div class="source-file">
    <div class="source-filename">{{ file }}</div>
    <div class="source-content">{{ rendered.html | safe }}</div>
  </div>
  {% endfor %}
</section>
{% endif %}

<section class="container">
  {% if not demo.broken %}
  <script src="/js/generated/enchilada-runtime.js"></script>
  <script src="{{ compiled_js }}"></script>
  {% endif %}
</section>
