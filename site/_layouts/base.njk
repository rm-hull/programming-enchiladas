<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="A ClojureScript-based HTML5 Canvas and SVG Graphics Playground, fetching and compiling ClojureScript gists at build time with shadow-cljs.">

  {% if title %}
    <title>Programming Enchiladas{{ ' · ' ~ title if title }}</title>
  {% else %}
    <title>Programming Enchiladas</title>
  {% endif %}

  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="//netdna.bootstrapcdn.com/font-awesome/4.0.0/css/font-awesome.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/prism.min.css">

  <!-- MathJax for rendering embedded math (MathML, LaTeX, AsciiMath) -->
  <script>
  if (typeof MathJax === 'undefined') {
    window.MathJax = {
      tex: {
        inlineMath: [['\\(', '\\)'], ['$', '$']],
        displayMath: [['\\[', '\\]']],
        processEscapes: true,
        processEnvironments: true
      },
      options: {
        ignoreHtmlClass: 'tex2jax_ignore',
        processHtmlClass: 'tex2jax_process'
      },
      startup: {
        pageDuration: 0
      }
    };
    (function() {
      var script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js';
      script.async = true;
      document.head.appendChild(script);
    })();
  }
  </script>

  <script src="https://code.jquery.com/jquery-1.12.4.min.js" integrity="sha256-ZosEbRLbNQzLpnKIkEdrPv7lOy9C27hHQ+Xp8a4MxAQ=" crossorigin="anonymous"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/react/0.12.1/react.min.js"></script>
  <script>
    // Ensure jQuery and $ are available globally for jayq
    if (typeof jQuery !== 'undefined') {
      window.$ = jQuery;
    }
  </script>

  {% if pagefind %}
  <link href="/pagefind/pagefind-component-ui.css" rel="stylesheet">
  {% endif %}
</head>
<body>
  <div class="header">
    <section class="container">
      <a class="header-logo" href="/" title="Programming Enchiladas Home">
        <i class="fa fa-cutlery"></i> Programming Enchiladas
      </a>
      <span class="command-bar">
        <ul class="top-nav">
          <li><a href="/random/" title="Random demo">Random</a></li>
          <li><a href="/latest/" title="Most recently added">Latest</a></li>
          <li><a href="/tags/" title="Browse by tag">Tags</a></li>
          <li><a href="/search/" title="Search demos">Search</a></li>
        </ul>
      </span>
    </div>
  </div>

  <div class="content">
    {{ content | safe }}
  </div>

  <div class="footer">
    <section class="container">
      <p>
        Site: copyright © {{ currentYear }} Richard Hull.
        License: <a href="https://opensource.org/licenses/MIT">MIT</a>
        &nbsp;&nbsp;Content: copyright as per respective owners.
      </p>
    </section>
  </div>

  {% if pagefind %}
  <script src="/pagefind/pagefind-component-ui.js" type="module"></script>
  <script>
  window.addEventListener('DOMContentLoaded', function() {
    if (window.pagefind && window.pagefind.init) {
      window.pagefind.init();
    }
  });
  </script>
  {% endif %}
</body>
</html>