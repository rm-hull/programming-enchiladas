{
  "name": "programming-enchiladas-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prestart": "[ -L content ] || ln -s ../content content",
    "prebuild": "[ -L content ] || ln -s ../content content",
    "build": "eleventy && pagefind --site _site",
    "pagefind": "pagefind --site _site",
    "start": "eleventy --serve"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "js-yaml": "^5.3.0",
    "katex": "^0.18.4",
    "markdown-it": "^15.0.1",
    "markdown-it-texmath": "^1.0.0",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "babel-loader": "^10.1.1",
    "pagefind": "^1.5.2"
  }
}
